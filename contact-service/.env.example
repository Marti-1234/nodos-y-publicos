# Variables de entorno del recurso Coolify — nunca commitear un .env real.

# SMTP (Google Workspace — los MX de nodosypublicos.com apuntan a Google,
# confirmado por consulta DNS pública; NO es Gandi). Requiere una contraseña
# de aplicación (no la contraseña normal de la cuenta): Google Account →
# Seguridad → Verificación en 2 pasos (debe estar activada) → Contraseñas
# de aplicaciones. Si es Workspace y esa opción no aparece, el administrador
# debe habilitar "Acceso de apps menos seguras" / SMTP relay para la cuenta,
# o usar el SMTP relay service de Google Workspace en su lugar.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Dirección que recibe los mensajes del formulario.
CONTACT_EMAIL_TO=info@nodosypublicos.com

# Origen exacto del one-pager (sin barra final). Único origen permitido por CORS.
ALLOWED_ORIGIN=https://preview.nodosypublicos.com

# Puerto en el que escucha el servicio dentro del contenedor.
PORT=3000
